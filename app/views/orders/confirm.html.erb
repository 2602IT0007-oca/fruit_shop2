<h1>注文確認</h1>

<%= form_with(model: @order, local: true, data: { turbo: false }) do |form| %>

  <h3>カート内の商品</h3>
  <table>
    <thead>
      <tr>
        <th>商品名</th>
        <th>個数</th>
        <th>価格</th>
        <th>合計</th>
      </tr>
    </thead>
    <tbody>
      <% @cart_items.each_with_index do |cart_item, index| %>
        <tr>
          <td><%= cart_item.product.name %></td>
          <td><%= cart_item.quantity %></td>
          <td><%= "¥" + number_with_delimiter(cart_item.product.price) %></td>
          <td><%= "¥" + number_with_delimiter(@item_totals[index]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <h4>合計金額</h4>
  <%= "¥" + number_with_delimiter(@cart_total) %>

  <h4>送り先</h4>
  <%= @order.address %>

  <%= form.hidden_field :address %>
  <%= form.hidden_field :total_price %>

  <div>
    <%= form.submit '注文する' %>
  </div>
<% end %>

<%= link_to '戻る', new_order_path %>